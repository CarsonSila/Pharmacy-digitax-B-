<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Ảnh sản phẩm -->
        <ImageView
            android:id="@+id/imgSanPham"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="6dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/app_name" />

        <!-- Tên sản phẩm -->
        <TextView
            android:id="@+id/tvTenSP"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Tên sản phẩm"
            android:textColor="@android:color/black"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Giá hiện tại + đơn vị -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvGia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="119.000đ"
                android:textColor="@color/blue"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDonViTinh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="/ Hộp"
                android:textColor="@color/blue"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Mô tả đơn vị (nền xám, bo góc) -->
        <TextView
            android:id="@+id/tvMoTaDonVi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_unit_label"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="Hộp 20 Gói x 5g"
            android:textColor="@android:color/darker_gray"
            android:textSize="12sp" />

        <!-- Nút chọn mua -->
        <Button
            android:id="@+id/btnChonMua"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/blue"
            android:text="Chọn mua"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            app:cornerRadius="30dp" />
    </LinearLayout>

</androidx.cardview.widget.CardView>
