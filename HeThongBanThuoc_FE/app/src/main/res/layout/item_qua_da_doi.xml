<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E0E0E0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: Ngày đổi + Trạng thái -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvNgayDoi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="15/01/2025 14:20"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="15/01/2025 14:20"/>

            <!-- Badge trạng thái -->
            <TextView
                android:id="@+id/tvTrangThai"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đổi thành công"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                tools:text="Đổi thành công"/>
        </LinearLayout>

        <!-- Thông tin quà -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <!-- Hình ảnh quà -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="80dp"
                android:layout_height="80dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/imgQuaTang"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ai"/>
            </com.google.android.material.card.MaterialCardView>

            <!-- Thông tin chi tiết -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <!-- Tên quà -->
                <TextView
                    android:id="@+id/tvTenQuaTang"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mặt nạ Banobagi Stem Cell Vitamin"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end"
                    tools:text="Mặt nạ Banobagi Stem Cell Vitamin"/>

                <!-- Số lượng -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Số lượng: "
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"/>

                    <TextView
                        android:id="@+id/tvSoLuong"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="x1"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="x1"/>
                </LinearLayout>

                <!-- Điểm đã sử dụng -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/coin"
                        app:tint="@color/yellow_coin"/>

                    <TextView
                        android:id="@+id/tvDiemSuDung"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1.500 điểm"
                        android:textColor="@color/yellow_coin"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginStart="4dp"
                        tools:text="1.500 điểm"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Ghi chú (nếu có) -->
        <TextView
            android:id="@+id/tvGhiChu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ghi chú: Giao hàng tại 123 ABC"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="Ghi chú: Giao hàng tại 123 ABC"/>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginVertical="12dp"/>

        <!-- Footer: Lưu ý nhận hàng -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/note"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Vui lòng đến cửa hàng để nhận quà"
                android:textColor="@color/orange_warning"
                android:textSize="12sp"
                android:layout_marginStart="6dp"/>

            <!-- Button liên hệ (optional) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLienHe"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Liên hệ"
                android:textSize="11sp"
                android:textColor="@color/blue_primary"
                app:backgroundTint="@android:color/transparent"
                app:strokeColor="@color/blue_primary"
                app:strokeWidth="1dp"
                app:cornerRadius="16dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>