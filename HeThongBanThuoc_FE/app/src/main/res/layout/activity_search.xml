<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fitsSystemWindows="true">

    <!-- Vùng chứa thanh tiêu đề và ô tìm kiếm -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_gradient_header"
        android:elevation="4dp"
        android:fitsSystemWindows="true">

        <!-- Hàng chứa nút quay lại và ô nhập tìm kiếm -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical">

            <!-- Nút quay lại -->
            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:background="@drawable/bg_circle_ripple"
                android:src="@drawable/back"
                app:tint="@android:color/white"
                android:contentDescription="Quay lại" />

            <!-- Ô nhập tìm kiếm -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="4dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="2dp"
                android:backgroundTint="@android:color/white">

                <!-- Bên trong ô tìm kiếm: icon, input, nút xóa -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="8dp">

                    <!-- Icon kính lúp -->
                    <ImageView
                        android:id="@+id/icSearch"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="10dp"
                        android:src="@drawable/search"
                        android:contentDescription="Tìm kiếm" />

                    <!-- Ô nhập nội dung tìm kiếm -->
                    <EditText
                        android:id="@+id/edtSearch"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="Tìm tên thuốc, bệnh lý, TPCN..."
                        android:textSize="14sp"
                        android:textColorHint="#B0B0B0"
                        android:textColor="#2C2C2C"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:fontFamily="sans-serif-medium" />

                    <!-- Nút xóa nội dung tìm kiếm -->
                    <ImageView
                        android:id="@+id/btnClearSearch"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/delete"
                        android:background="@drawable/bg_circle_ripple_gray"
                        android:padding="6dp"
                        android:scaleType="centerInside"
                        app:tint="#999999"
                        android:visibility="gone"
                        android:contentDescription="Xóa" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Khu vực cuộn chính -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Khối: Lịch sử tìm kiếm -->
            <androidx.cardview.widget.CardView
                android:id="@+id/sectionLichSu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                android:visibility="gone">

                <!-- Nội dung lịch sử tìm kiếm -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Tiêu đề + nút "Xóa tất cả" -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingBottom="8dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/history"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Lịch sử tìm kiếm"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#2C2C2C"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/tvXoaTatCa"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Xóa tất cả"
                            android:textSize="13sp"
                            android:textColor="@color/blue_button"
                            android:paddingVertical="6dp"
                            android:paddingHorizontal="12dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="@drawable/bg_rounded_ripple"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>

                    <!-- Đường kẻ chia -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E8E8E8"
                        android:layout_marginBottom="8dp" />

                    <!-- Danh sách lịch sử -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvLichSu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Khối: Tra cứu hàng đầu -->
            <androidx.cardview.widget.CardView
                android:id="@+id/sectionTrending"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                android:visibility="gone">

                <!-- Nội dung tra cứu hàng đầu -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Tiêu đề -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingBottom="8dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/fire"
                            app:tint="#FF6B6B"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tra cứu hàng đầu"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#2C2C2C"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>

                    <!-- Đường kẻ chia -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E8E8E8"
                        android:layout_marginBottom="12dp" />

                    <!-- Danh sách từ khóa trending (hiển thị bằng Flexbox) -->
                    <com.google.android.flexbox.FlexboxLayout
                        android:id="@+id/flexTrending"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:flexWrap="wrap"
                        app:alignItems="flex_start"
                        app:alignContent="flex_start" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Khối: Kết quả tìm kiếm -->
            <LinearLayout
                android:id="@+id/sectionKetQua"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Tabs chọn loại kết quả -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginBottom="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">

                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/tabLayout"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@android:color/white"
                        app:tabTextColor="#999999"
                        app:tabSelectedTextColor="@color/blue_button"
                        app:tabIndicatorColor="@color/blue_light"
                        app:tabIndicatorHeight="3dp"
                        app:tabTextAppearance="@style/TabTextStyle">

                        <com.google.android.material.tabs.TabItem
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Danh sách sản phẩm"
                            android:textStyle="bold"/>
                    </com.google.android.material.tabs.TabLayout>
                </androidx.cardview.widget.CardView>

                <!-- Thanh sắp xếp kết quả -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginBottom="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/sort"
                            app:tint="#999999"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sắp xếp theo:"
                            android:textSize="13sp"
                            android:textColor="#666666"
                            android:layout_marginEnd="8dp"
                            android:fontFamily="sans-serif-medium" />

                        <!-- Các nút tùy chọn sắp xếp -->
                        <TextView
                            android:id="@+id/tvSortBanChay"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bán chạy"
                            android:textSize="13sp"
                            android:textColor="@android:color/white"
                            android:background="@drawable/bg_sort_selected"
                            android:paddingVertical="6dp"
                            android:paddingHorizontal="14dp"
                            android:layout_marginEnd="8dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/tvSortGiaThap"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Giá thấp"
                            android:textSize="13sp"
                            android:textColor="#666666"
                            android:background="@drawable/bg_sort_unselected"
                            android:paddingVertical="6dp"
                            android:paddingHorizontal="14dp"
                            android:layout_marginEnd="8dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/tvSortGiaCao"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Giá cao"
                            android:textSize="13sp"
                            android:textColor="#666666"
                            android:background="@drawable/bg_sort_unselected"
                            android:paddingVertical="6dp"
                            android:paddingHorizontal="14dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Ghi chú cho thuốc kê đơn -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    android:backgroundTint="#FFF8E1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/exclamation"
                            android:layout_marginEnd="10dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Thuốc kê đơn và một số sản phẩm cần tư vấn từ dược sĩ"
                            android:textSize="12sp"
                            android:textColor="#F57C00"
                            android:lineSpacingExtra="2dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Danh sách kết quả tìm kiếm -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvKetQuaSanPham"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="6dp"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false" />

                <!-- Giao diện trống khi không có kết quả -->
                <LinearLayout
                    android:id="@+id/layoutEmptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="48dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="140dp"
                        android:layout_height="140dp"
                        android:src="@drawable/empty"
                        android:alpha="0.6" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Không tìm thấy sản phẩm"
                        android:textSize="17sp"
                        android:textColor="#4A4A4A"
                        android:textStyle="bold"
                        android:layout_marginTop="20dp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hãy thử với từ khóa khác"
                        android:textSize="14sp"
                        android:textColor="#999999"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Khoảng trống phía dưới -->
            <View
                android:layout_width="match_parent"
                android:layout_height="20dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Hộp hiển thị loading khi đang tìm kiếm -->
    <androidx.cardview.widget.CardView
        android:id="@+id/loadingCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center">

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:indeterminateTint="@color/blue_light" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đang tìm kiếm..."
                android:textSize="13sp"
                android:textColor="#666666"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
