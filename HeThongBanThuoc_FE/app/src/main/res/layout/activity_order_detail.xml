<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fitsSystemWindows="true">

    <!-- HEADER động (AppBar) -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:background="@drawable/logo_status"
        android:elevation="0dp"
        android:fitsSystemWindows="true">

        <RelativeLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingTop="12dp"
            android:paddingHorizontal="16dp"
            android:paddingBottom="4dp">

            <!-- Nút Back -->
            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:padding="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/back"
                app:tint="@android:color/white"
                android:contentDescription="Quay lại" />

            <!-- Tiêu đề trạng thái -->
            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_alignTop="@id/btnBack"
                android:layout_marginTop="8dp"
                android:text="Đã giao"
                android:textSize="20sp"
                android:textColor="@color/blue_dark"
                android:textStyle="bold" />

            <!-- Nội dung minh họa + thông báo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvHeaderTitle"

                android:layout_centerInParent="true"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvStatusMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Rất vui vì bạn đã tin tưởng và mua hàng."
                    android:textSize="15sp"
                    android:textColor="@color/chip_text_selector"
                    android:gravity="center"
                    android:paddingHorizontal="24dp"
                    android:lineSpacingExtra="2dp" />
                <ImageView
                    android:id="@+id/imgStatusIllustration"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginTop="50dp"
                    android:src="@drawable/order_delivered"
                    android:scaleType="fitCenter" />
            </LinearLayout>
        </RelativeLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Vùng nội dung và nút dưới -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Nội dung cuộn -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/nestedScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="80dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Thông tin đơn hàng -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="2dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tvDonHang"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Đơn hàng 16/07/2025"
                                android:textSize="16sp"
                                android:textColor="#333333"
                                android:textStyle="bold"
                                android:layout_marginEnd="8dp" />

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/calendar"
                                android:contentDescription="Icon Lịch"/>
                        </LinearLayout>


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Nhận tại cửa hàng"
                                android:textSize="13sp"
                                android:textColor="#666666" />

                            <TextView
                                android:id="@+id/tvMaDonHang"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="#6462373"
                                android:textSize="13sp"
                                android:textColor="@color/colorPrimary"
                                android:textStyle="bold"
                                android:layout_marginStart="8dp" />

                            <TextView
                                android:id="@+id/btnCopy"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Sao chép"
                                android:textSize="12sp"
                                android:textColor="@color/colorPrimary"
                                android:layout_marginStart="8dp"
                                android:background="?attr/selectableItemBackground"
                                android:padding="4dp" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Thông tin nhận hàng -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="2dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Thông tin nhận hàng"
                            android:textSize="15sp"
                            android:textColor="#333333"
                            android:textStyle="bold"
                            android:layout_marginBottom="12dp" />

                        <!-- Tên người nhận -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="8dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/people"
                                app:tint="#666666" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Thông tin người nhận"
                                android:textSize="13sp"
                                android:textColor="#999999"
                                android:layout_marginStart="8dp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvTenNguoiNhan"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Bùi Mạnh Hưng"
                            android:textSize="14sp"
                            android:textColor="#333333"
                            android:textStyle="bold"
                            android:layout_marginStart="28dp"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/tvSoDienThoai"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="0568 503 606"
                            android:textSize="14sp"
                            android:textColor="#666666"
                            android:layout_marginStart="28dp"
                            android:layout_marginBottom="16dp" />

                        <!-- Địa chỉ nhận hàng -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="8dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/location"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Nhận hàng tại"
                                android:textSize="13sp"
                                android:textColor="#999999"
                                android:layout_marginStart="8dp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvDiaChiNhanHang"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Nhà thuốc Long Châu 10-10A-12 Lý Thường Kiệt, Phường Lê Thanh Nghị, TP. Hải Phòng"
                            android:textSize="14sp"
                            android:textColor="#333333"
                            android:layout_marginStart="28dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Danh sách sản phẩm -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="2dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Danh sách sản phẩm"
                            android:textSize="15sp"
                            android:textColor="#333333"
                            android:textStyle="bold"
                            android:layout_marginBottom="12dp" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerViewProducts"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Thông tin thanh toán -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="2dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Thông tin thanh toán"
                            android:textSize="15sp"
                            android:textColor="#333333"
                            android:textStyle="bold"
                            android:layout_marginBottom="12dp" />

                        <!-- Tổng tiền -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Tổng tiền"
                                android:textSize="14sp"
                                android:textColor="#666666" />

                            <TextView
                                android:id="@+id/tvTongTien"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="340.000đ"
                                android:textSize="14sp"
                                android:textColor="#333333" />
                        </LinearLayout>

                        <!-- Giảm giá trực tiếp -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Giảm giá trực tiếp"
                                android:textSize="14sp"
                                android:textColor="#666666" />

                            <TextView
                                android:id="@+id/tvGiamGia"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0đ"
                                android:textSize="14sp"
                                android:textColor="#333333" />
                        </LinearLayout>

                        <!-- Giảm giá voucher -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Giảm giá voucher"
                                android:textSize="14sp"
                                android:textColor="#666666" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0đ"
                                android:textSize="14sp"
                                android:textColor="#333333" />
                        </LinearLayout>

                        <!-- Phí vận chuyển -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="16dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Phí vận chuyển"
                                android:textSize="14sp"
                                android:textColor="#666666" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Miễn phí"
                                android:textSize="14sp"
                                android:textColor="@android:color/holo_green_dark"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Divider -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#EEEEEE"
                            android:layout_marginBottom="12dp" />

                        <!-- Thành tiền -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Thành tiền"
                                android:textSize="16sp"
                                android:textColor="#333333"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvThanhTien"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="340.000đ"
                                android:textSize="18sp"
                                android:textColor="@color/colorPrimary"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Điểm thưởng -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Điểm thưởng"
                                android:textSize="13sp"
                                android:textColor="#666666" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/star"
                                app:tint="#FFD700" />

                            <TextView
                                android:id="@+id/tvDiemThuong"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="+340"
                                android:textSize="13sp"
                                android:textColor="#FFD700"
                                android:textStyle="bold"
                                android:layout_marginStart="4dp" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Button chức năng  -->
        <LinearLayout
            android:id="@+id/bottomButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:background="@android:color/white"
            android:padding="16dp"
            android:elevation="8dp">

            <!-- Nút Hỗ trợ - Sẽ full width khi nút Mua lại bị ẩn -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHoTro"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Hỗ trợ"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textColor="@color/colorPrimary"
                app:cornerRadius="10dp"
                app:strokeColor="@color/colorPrimary"
                app:strokeWidth="1dp"
                app:backgroundTint="@android:color/white" />

            <!-- Nút Mua lại - Chỉ hiển thị khi đơn hàng đã giao -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMuaLai"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Mua lại"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textColor="@android:color/white"
                app:cornerRadius="10dp"
                app:backgroundTint="@color/colorPrimary"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    <!-- Loading -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
