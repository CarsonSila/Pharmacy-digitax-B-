<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background -->
    <ImageView
        android:id="@+id/bgImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/splash" />

    <!-- Overlay mờ nền -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000" />

    <!-- Nội dung chính -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Logo -->
            <ImageView
                android:id="@+id/logoImage"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/logo"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:elevation="8dp" />

            <!-- App Title -->
            <TextView
                android:id="@+id/appTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NHÀ THUỐC VIỆT PHÚC"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:shadowColor="#000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="4"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/subTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sức khỏe của bạn, sứ mệnh của chúng tôi"
                android:textSize="14sp"
                android:textColor="#E0E0E0"
                android:layout_marginBottom="32dp"/>

            <!-- Card Form -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:cardElevation="12dp"
                app:cardBackgroundColor="#F0FFFFFF"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="28dp">

                    <!-- Heading -->
                    <TextView
                        android:id="@+id/tvSignUp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Đăng ký"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:textColor="#2C3E50"
                        android:layout_marginBottom="6dp"
                        android:gravity="center"/>

                    <TextView
                        android:id="@+id/tvEnterYour"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nhập thông tin của bạn để tiếp tục"
                        android:textSize="14sp"
                        android:textColor="#7F8C8D"
                        android:layout_marginBottom="20dp"
                        android:gravity="center"/>

                    <!-- Name -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="4dp"
                        android:layout_marginBottom="16dp"
                        app:cardBackgroundColor="@android:color/white">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="16dp">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/user"
                                app:tint="#3A8DFF"
                                android:layout_marginEnd="12dp"/>

                            <EditText
                                android:id="@+id/edtName"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:hint="Name"
                                android:background="@null"
                                android:inputType="textPersonName"
                                android:textSize="15sp"
                                android:textColor="#2C3E50"
                                android:textColorHint="#BDC3C7"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Email -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="4dp"
                        android:layout_marginBottom="16dp"
                        app:cardBackgroundColor="@android:color/white">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="16dp">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/email"
                                app:tint="#3A8DFF"
                                android:layout_marginEnd="12dp"/>

                            <EditText
                                android:id="@+id/edtEmail"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:hint="Email"
                                android:background="@null"
                                android:inputType="textEmailAddress"
                                android:textSize="15sp"
                                android:textColor="#2C3E50"
                                android:textColorHint="#BDC3C7"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Password -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="4dp"
                        android:layout_marginBottom="20dp"
                        app:cardBackgroundColor="@android:color/white">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="16dp">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/lock"
                                app:tint="#3A8DFF"
                                android:layout_marginEnd="12dp"/>

                            <EditText
                                android:id="@+id/edtPassword"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:hint="Password"
                                android:background="@null"
                                android:inputType="textPassword"
                                android:textSize="15sp"
                                android:textColor="#2C3E50"
                                android:textColorHint="#BDC3C7"/>

                            <ImageView
                                android:id="@+id/ivTogglePassword"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/un_lock"
                                app:tint="#7F8C8D"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Sign Up Button -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="28dp"
                        app:cardElevation="6dp"
                        android:layout_marginBottom="12dp">

                        <Button
                            android:id="@+id/btnSignUp"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:text="Đăng ký"
                            android:textAllCaps="false"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:backgroundTint="#3A8DFF"
                            android:textColor="@android:color/white"
                            style="@style/Widget.MaterialComponents.Button"
                            app:cornerRadius="28dp"/>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Sign Up -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bạn đã có tài khoản? "
                    android:textSize="14sp"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/tvSingup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đăng nhập"
                    android:textSize="14sp"
                    android:textColor="#2196F3"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
