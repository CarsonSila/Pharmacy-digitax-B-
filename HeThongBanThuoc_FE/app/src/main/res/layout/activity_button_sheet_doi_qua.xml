<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Handle bar (thanh kéo) -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="#DDDDDD"
            android:layout_marginBottom="16dp" />
        <!-- Tiêu đề -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đổi quà"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"/>

        <!-- Thông tin quà -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_rounded_color"
            android:padding="12dp"
            android:layout_marginTop="20dp">

            <!-- Hình ảnh quà -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="80dp"
                android:layout_height="80dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/imgQuaTang"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ai"/>
            </com.google.android.material.card.MaterialCardView>

            <!-- Tên quà -->
            <TextView
                android:id="@+id/tvTenQuaTang"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Mặt nạ cấp ẩm Banobagi Stem Cell Vitamin Mask dưỡng sáng da (30g)"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="3"
                android:ellipsize="end"
                android:layout_marginStart="12dp"
                android:layout_gravity="center_vertical"
                tools:text="Mặt nạ cấp ẩm Banobagi Stem Cell Vitamin"/>
        </LinearLayout>

        <!-- Số lượng -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Số lượng:"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_quantity_selector"
                android:paddingVertical="4dp"
                android:paddingHorizontal="8dp">

                <ImageView
                    android:id="@+id/btnGiamSoLuong"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/minus_circle"
                    android:padding="6dp"
                    app:tint="@color/blue_primary"/>

                <TextView
                    android:id="@+id/tvSoLuong"
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginHorizontal="8dp"
                    tools:text="1"/>

                <ImageView
                    android:id="@+id/btnTangSoLuong"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/plus_circle"
                    android:padding="6dp"
                    app:tint="@color/blue_primary"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginVertical="16dp"/>

        <!-- Điểm sử dụng -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Điểm sử dụng:"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/coin"
                    app:tint="@color/yellow_coin"/>

                <TextView
                    android:id="@+id/tvDiemSuDung"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-1.500"
                    android:textColor="@color/yellow_coin"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginStart="4dp"
                    tools:text="-1.500"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Điểm hiện có -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Điểm hiện có:"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/tvDiemHienCo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.252"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="1.252"/>
        </LinearLayout>

        <!-- Điểm còn lại -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Điểm còn lại:"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/tvDiemConLai"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="252 điểm"
                android:textColor="@color/green_success"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="252 điểm"/>
        </LinearLayout>

        <!-- Warning nếu không đủ điểm -->
        <LinearLayout
            android:id="@+id/layoutWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_warning"
            android:padding="12dp"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/exclamation"/>

            <TextView
                android:id="@+id/tvWarning"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Không đủ điểm thưởng."
                android:textColor="@color/red_error"
                android:textSize="13sp"
                android:layout_marginStart="8dp"
                tools:text="Không đủ điểm thưởng."/>
        </LinearLayout>

        <!-- Lưu ý quan trọng -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_info_light"
            android:padding="12dp"
            android:layout_marginTop="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/note"
                android:layout_marginTop="2dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lưu ý"
                    android:textColor="@color/blue_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Quà chỉ có thể nhận tại cửa hàng&#10;• Vui lòng mang theo điện thoại để xác nhận&#10;• Quà có giá trị trong 30 ngày"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Button Xác nhận -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnXacNhan"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Xác nhận"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/blue_primary"
            app:cornerRadius="12dp"
            android:layout_marginTop="20dp"
            android:enabled="true"/>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>