<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Nền trắng -->
    <solid android:color="@android:color/white" />

    <!-- Bo góc -->
    <corners android:radius="12dp" />

    <!-- Viền mờ -->
    <stroke
        android:width="1dp"
        android:color="#E0E0E0" />

    <!-- Bóng mờ -->
    <padding
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp" />
</shape>
