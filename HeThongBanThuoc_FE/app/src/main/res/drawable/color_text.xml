<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Focused state -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <!-- 3D hiệu ứng: gradient nhẹ -->
            <gradient
                android:angle="90"
                android:startColor="#FFFFFFFF"
                android:centerColor="#FFF6F6F6"
                android:endColor="#FFECECEC" />  <!-- dưới tối hơn -->

            <!-- Viền nổi hơn khi focus -->
            <stroke
                android:width="2dp"
                android:color="#FF3A7BD5" />  <!-- màu viền khi focus (xanh dương) -->

            <corners android:radius="12dp" />
            <padding
                android:left="12dp"
                android:top="10dp"
                android:right="12dp"
                android:bottom="10dp" />
        </shape>
    </item>

    <!-- Default state -->
    <item>
        <layer-list>
            <!-- Shadow giả (dùng shape mờ nằm dưới để tạo cảm giác nổi) -->
            <item android:top="2dp" android:left="0dp" android:right="0dp" android:bottom="0dp">
                <shape android:shape="rectangle">
                    <solid android:color="#11000000" /> <!-- bóng mờ -->
                    <corners android:radius="24dp" />
                </shape>
            </item>

            <!-- Main background -->
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="90"
                        android:startColor="#FFFFFFFF"
                        android:endColor="#FFF8F8F8" />
                    <stroke
                        android:width="1dp"
                        android:color="#FFBDBDBD" /> <!-- viền xám nhẹ -->
                    <corners android:radius="12dp" />
                    <padding
                        android:left="12dp"
                        android:top="10dp"
                        android:right="12dp"
                        android:bottom="10dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
