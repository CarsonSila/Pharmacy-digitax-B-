# ─────────────────────────────────────────────────────────────
# PharmaCore — Environment Variables Template
# ─────────────────────────────────────────────────────────────
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in EVERY value below
#   3. NEVER commit .env — it's already in .gitignore
#
# GENERATE A SECURE JWT SECRET:
#   Linux/Mac:  openssl rand -base64 48
#   Windows:    [System.Convert]::ToBase64String((1..48 | ForEach-Object { [byte](Get-Random -Max 256) }))
# ─────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
DB_ROOT_PASSWORD=change_this_root_password
DB_USERNAME=appuser
DB_PASSWORD=change_this_app_password

# ── JWT (minimum 32 random characters) ───────────────────────
JWT_SECRET=REPLACE_WITH_OUTPUT_OF_openssl_rand_base64_48

# ── Gmail SMTP (use App Password, not your login password) ───
# Get App Password: Google Account → Security → 2FA → App Passwords
MAIL_USERNAME=your-pharmacy-email@gmail.com
MAIL_PASSWORD=your_16_char_gmail_app_password

# ── Google Gemini AI ──────────────────────────────────────────
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy_your_key_here
