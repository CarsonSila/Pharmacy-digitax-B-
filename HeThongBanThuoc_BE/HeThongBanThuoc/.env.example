# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# Database
DB_URL=jdbc:mysql://localhost:3306/he_thong_ban_thuoc?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_db_password_here

# Email (Gmail App Password — NOT your login password)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your_gmail_app_password_here

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here

# JWT — must be at least 32 random characters
# Generate with: openssl rand -base64 48
JWT_SECRET=your_very_long_random_secret_key_here_at_least_32_chars

# File uploads — absolute path to upload directory
UPLOAD_DIR=/app/uploads
